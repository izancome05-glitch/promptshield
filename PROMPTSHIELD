    },
    {
      id: 'negociador', icon: '📞', name: 'Negociador de Facturas',
      desc: 'Guion de llamada para pedir una rebaja.',
      fields: [
        { label: 'Servicio, importe y condiciones', ph: 'Fibra + móvil, 62 €/mes, permanencia hasta marzo…', req: true, rows: 4 },
        { label: 'Qué te gustaría conseguir (opcional)', ph: 'Bajar a 45 €/mes, quitar la permanencia…', rows: 2 },
