// @name         PromptShield
// @namespace    https://promptshield.local/
// @version      3.0.0
// @description  Cortafuegos de privacidad para IAs (datos sensibles -> marcadores reversibles en local) + 8 herramientas de un clic cuyo texto también pasa por la protección.
// @author       IzanHermoso
// @copyright    IzanHermoso
// @match        https://chatgpt.com/*
// @match        https://chat.openai.com/*
// @match        https://claude.ai/*
