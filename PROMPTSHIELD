/*
 * PromptShield 3.0.0 · Creado por IzanHermoso
 * ------------------------------------------------------------------
 * Flujo:  tu texto -> detección local -> marcadores [IBAN_1_X7Q] -> IA
 *         respuesta de la IA -> marcadores restaurados SOLO en tu pantalla
 *
 * Novedades 3.0.0: rediseño completo de la interfaz (sistema "Tinta y latón"), iconos SVG propios,
 *  controles segmentados, selector de herramientas con categorías y distintivo de autoría.
 *
 * Novedades 2.2.0: reglas de protección (tipos, IP, palabras propias), vista previa del texto
 *  protegido, atajos de teclado y 16 herramientas.
 *
 * Novedades 2.0.0:
 *  - Menú "Herramientas" con 8 funciones de un clic. Cada una escribe un prompt
 *    en el editor y lo envía PASANDO por la detección de datos sensibles.
 *  - Accesibilidad: la píldora responde a Enter/Espacio, el panel se cierra al
 *    pulsar fuera, los diálogos atrapan el foco con Tab y aíslan el teclado de la página.
 *
 * Principios:
 *  - Todo ocurre en tu navegador. Sin red, sin telemetría, sin eval.
 *  - Fallo seguro: si algo falla, el envío se BLOQUEA y se te avisa.
 *  - El mapa marcador<->dato real vive solo en memoria (closure privada);
 *    no se guarda en localStorage porque los scripts de la página podrían leerlo.
 *    Las herramientas tampoco guardan nada (ni siquiera el diario).
 */

(function () {
  'use strict';

  if (document.getElementById('promptshield-host')) return; // evita doble inyección

  /* ===== CORE:START ===== (lógica pura, sin DOM: se puede testear en Node) */
  const Core = (() => {
    const MAX_LEN = 1_000_000; // por encima, se rechaza (fallo seguro)
    const MAX_MATCHES = 2000;

    const DNI_LETTERS = 'TRWAGMYFPDXBNJZSQVHLCKE';

    // Longitud oficial del IBAN por país (los países no listados no se detectan).
    const IBAN_LENGTHS = {
      AD: 24, AT: 20, BE: 16, BG: 22, CH: 21, CY: 28, CZ: 24, DE: 22, DK: 18,
      EE: 20, ES: 24, FI: 18, FR: 27, GB: 22, GI: 23, GR: 27, HR: 21, HU: 28,
      IE: 22, IS: 26, IT: 27, LI: 21, LT: 20, LU: 20, LV: 21, MC: 27, MT: 31,
      NL: 18, NO: 15, PL: 28, PT: 25, RO: 24, SE: 24, SI: 19, SK: 24, SM: 27,
    };

    const TYPE_LABEL = {
      SECRETO: 'Clave / secreto',
      IBAN: 'IBAN',
      TARJETA: 'Tarjeta bancaria',
      DNI: 'DNI',
      NIE: 'NIE',
      EMAIL: 'Email',
      TELEFONO: 'Teléfono',
      IP: 'Dirección IP',
      PERSONALIZADO: 'Palabra propia',
    };

    // En solapes gana el tipo de menor número (lo más crítico primero).
    const PRIORITY = { SECRETO: 0, IBAN: 1, TARJETA: 2, DNI: 3, NIE: 3, EMAIL: 4, PERSONALIZADO: 4, TELEFONO: 5, IP: 6 };

    // Formato del marcador: [TIPO_n_ABC]. "ABC" es una etiqueta aleatoria de sesión:
    // evita restaurar mal marcadores antiguos tras recargar la página.
    const PLACEHOLDER_SRC = '\\[[A-Z]+_\\d+_[A-Z0-9]{3}\\]';
    const PLACEHOLDER_FULL = new RegExp('^' + PLACEHOLDER_SRC + '$');
    const PLACEHOLDER_ANY = new RegExp(PLACEHOLDER_SRC);

    /* ---------- Validadores matemáticos ---------- */

    function isValidDni(s) {
      const m = /^(\d{8})[- ]?([A-Za-z])$/.exec(s);
      return !!m && DNI_LETTERS[Number(m[1]) % 23] === m[2].toUpperCase();
    }

    function isValidNie(s) {
      const m = /^([XYZxyz])[- ]?(\d{7})[- ]?([A-Za-z])$/.exec(s);
      if (!m) return false;
      const n = Number(String('XYZ'.indexOf(m[1].toUpperCase())) + m[2]);
      return DNI_LETTERS[n % 23] === m[3].toUpperCase();
    }

    function luhn(digits) {
      let sum = 0;
      let alt = false;
      for (let i = digits.length - 1; i >= 0; i--) {
        let d = digits.charCodeAt(i) - 48;
        if (d < 0 || d > 9) return false;
        if (alt) {
          d *= 2;
          if (d > 9) d -= 9;
        }
        sum += d;
        alt = !alt;
      }
      return digits.length > 0 && sum % 10 === 0;
    }

    function isValidCard(raw) {
      const d = raw.replace(/\D/g, '');
      return d.length >= 13 && d.length <= 19 && !/^(\d)\1+$/.test(d) && luhn(d);
    }

    // ISO 13616: se mueven los 4 primeros caracteres al final y se calcula mod 97 por trozos.
    function ibanMod97(iban) {
      const s = iban.slice(4) + iban.slice(0, 4);
      let rem = 0;
      for (let i = 0; i < s.length; i++) {
        const c = s.charCodeAt(i);
        if (c >= 48 && c <= 57) rem = (rem * 10 + (c - 48)) % 97;
        else if (c >= 65 && c <= 90) rem = (rem * 100 + (c - 55)) % 97;
        else return false;
      }
      return rem === 1;
    }

    function phoneDigits(v) {
      return v.replace(/\D/g, '');
    }
    function isValidEsPhone(v) {
      let d = phoneDigits(v);
      if (v.startsWith('00')) d = d.slice(4);
      else if (v.startsWith('+34')) d = d.slice(2);
      return d.length === 9;
    }
    function isValidIntlPhone(v) {
      const n = phoneDigits(v).length;
      return n >= 8 && n <= 15;
    }

    /* ---------- Patrones ---------- */

    const SECRET_PATTERNS = [
      /\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}/g, // OpenAI / Anthropic
      /\bgh[pousr]_[A-Za-z0-9]{30,}\b/g, // GitHub
      /\bgithub_pat_[A-Za-z0-9_]{22,}\b/g,
      /\b(?:AKIA|ASIA)[A-Z0-9]{16}\b/g, // AWS
      /\bAIza[0-9A-Za-z_-]{35}\b/g, // Google API
      /\bxox[abprs]-[A-Za-z0-9-]{10,}/g, // Slack
      /\b[sr]k_(?:live|test)_[A-Za-z0-9]{16,}\b/g, // Stripe
      /\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}/g, // JWT
      /-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]*?-----END [A-Z ]*PRIVATE KEY-----/g,
    ];
    const BEARER_RE = /\bBearer\s+([A-Za-z0-9._~+/-]{16,}=*)/g;
    // "password: xxx", "api_key=xxx"… solo se sustituye el VALOR (grupo 1).
    const ASSIGN_RE =
      /\b(?:password|passwd|pwd|contraseña|secret|token|api[_-]?key|apikey|access[_-]?key)\s*[:=]\s*["']?([^\s"'`]{6,})/gi;

    const DNI_RE = /(?<![A-Za-z0-9])\d{8}[- ]?[A-Za-z](?![A-Za-z0-9])/g;
    const NIE_RE = /(?<![A-Za-z0-9])[XYZxyz][- ]?\d{7}[- ]?[A-Za-z](?![A-Za-z0-9])/g;
    const EMAIL_RE =
      /(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}(?![A-Za-z0-9-])/g;
    const CARD_RE = /(?<!\d)\d(?:[ -]?\d){12,18}(?!\d)/g;
    const PHONE_ES_RE =
      /(?<![\w+])(?:(?:\+|00)34[ .-]?)?[6789]\d{2}(?:[ .-]?\d{3}[ .-]?\d{3}|[ .-]?\d{2}[ .-]?\d{2}[ .-]?\d{2})(?![\w])/g;
    const PHONE_INTL_RE = /(?<![\w+])\+(?!34)\d{1,3}(?:[ .-]?\d{2,4}){2,4}(?![\w])/g;
    const IBAN_START_RE = /(?<![A-Za-z0-9])[A-Za-z]{2}\d{2}(?=[ ]?[A-Za-z0-9])/g;

    /* ---------- Escáneres ---------- */

    function scan(text, re, type, opts) {
      const group = (opts && opts.group) || 0;
      const validate = opts && opts.validate;
      const out = [];
      re.lastIndex = 0;
      let m;
      while ((m = re.exec(text)) !== null) {
        if (m[0].length === 0) {
          re.lastIndex++;
          continue;
        }
        const value = m[group];
        if (value === undefined) continue;
        // El grupo capturado siempre está al final del match en nuestros patrones.
        const start = group ? m.index + m[0].length - value.length : m.index;
        if (!validate || validate(value)) {
          out.push({ type, start, end: start + value.length, value });
        }
      }
      return out;
    }

    const isAlnum = (ch) => ch !== undefined && /[A-Za-z0-9]/.test(ch);

    // El IBAN puede venir con espacios: se consume exactamente la longitud del país.
    function scanIbans(text) {
      const out = [];
      IBAN_START_RE.lastIndex = 0;
      let m;
      while ((m = IBAN_START_RE.exec(text)) !== null) {
        const start = m.index;
        const len = IBAN_LENGTHS[m[0].slice(0, 2).toUpperCase()];
        if (!len) continue;
        let i = start;
        let count = 0;
        let compact = '';
        while (i < text.length && count < len) {
          const ch = text[i];
          if (isAlnum(ch)) {
            compact += ch.toUpperCase();
            count++;
            i++;
          } else if ((ch === ' ' || ch === '\u00a0') && count > 0 && isAlnum(text[i + 1])) {
            i++;
          } else break;
        }
        if (count !== len || isAlnum(text[i]) || !ibanMod97(compact)) continue;
        out.push({ type: 'IBAN', start, end: i, value: text.slice(start, i) });
        IBAN_START_RE.lastIndex = i;
      }
      return out;
    }

    const IP_RE = /(?<![\w.])(?:(?:25[0-5]|2[0-4]\d|1?\d?\d)\.){3}(?:25[0-5]|2[0-4]\d|1?\d?\d)(?![\w]|\.\d)/g;
    const isUsableIp = (v) => !['0.0.0.0', '127.0.0.1', '255.255.255.255'].includes(v);

    // Palabras propias (nombres, empresas, proyectos...). Solo viven en memoria.
    let customRe = null;
    function setCustomTerms(list) {
      try {
        const terms = Array.from(new Set((list || []).map((t) => String(t).trim()).filter((t) => t.length >= 2)))
          .sort((a, b) => b.length - a.length)
          .slice(0, 200);
        customRe = terms.length
          ? new RegExp(
              '(?<![\\p{L}\\p{N}])(?:' + terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|') + ')(?![\\p{L}\\p{N}])',
              'giu'
            )
          : null;
      } catch (_) {
        customRe = null;
      }
    }

    // Tipos que el usuario ha desactivado (los secretos no se pueden desactivar).
    let disabled = new Set();
    function setDisabled(types) {
      disabled = new Set((types || []).filter((t) => t !== 'SECRETO'));
    }

    /** Devuelve los datos sensibles de `text`, sin solapes y ordenados por posición. */
    function detect(text) {
      if (typeof text !== 'string') throw new TypeError('PromptShield: se esperaba texto');
      if (text.length > MAX_LEN) throw new RangeError('El mensaje es demasiado largo para analizarlo con seguridad.');

      const c = [];
      for (const re of SECRET_PATTERNS) c.push(...scan(text, re, 'SECRETO'));
      c.push(...scan(text, BEARER_RE, 'SECRETO', { group: 1 }));
      c.push(...scan(text, ASSIGN_RE, 'SECRETO', { group: 1 }));
      c.push(...scanIbans(text));
      c.push(...scan(text, CARD_RE, 'TARJETA', { validate: isValidCard }));
      c.push(...scan(text, DNI_RE, 'DNI', { validate: isValidDni }));
      c.push(...scan(text, NIE_RE, 'NIE', { validate: isValidNie }));
      c.push(...scan(text, EMAIL_RE, 'EMAIL'));
      c.push(...scan(text, PHONE_ES_RE, 'TELEFONO', { validate: isValidEsPhone }));
      c.push(...scan(text, PHONE_INTL_RE, 'TELEFONO', { validate: isValidIntlPhone }));
      c.push(...scan(text, IP_RE, 'IP', { validate: isUsableIp }));
      if (customRe) c.push(...scan(text, customRe, 'PERSONALIZADO'));

      if (c.length > MAX_MATCHES * 4) throw new RangeError('Demasiados datos sensibles para procesarlos con seguridad.');

      c.sort(
        (a, b) =>
          PRIORITY[a.type] - PRIORITY[b.type] ||
          b.end - b.start - (a.end - a.start) ||
          a.start - b.start
      );
      const accepted = [];
      for (const x of c) {
        if (disabled.has(x.type) || PLACEHOLDER_FULL.test(x.value)) continue; // desactivado o ya es un marcador
        if (!accepted.some((a) => x.start < a.end && a.start < x.end)) accepted.push(x);
        if (accepted.length > MAX_MATCHES) throw new RangeError('Demasiados datos sensibles para procesarlos con seguridad.');
      }
      return accepted.sort((a, b) => a.start - b.start);
    }

    /* ---------- Vault: mapa marcador <-> dato real ---------- */

    class Vault {
      constructor(tag) {
        this.tag = tag || Vault.randomTag();
        this.byValue = new Map();
        this.byPlaceholder = new Map();
        this.counters = Object.create(null);
      }
      static randomTag() {
        const A = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
        const b = new Uint8Array(3);
        crypto.getRandomValues(b);
        return Array.from(b, (x) => A[x % A.length]).join('');
      }
      /** Mismo dato -> mismo marcador (la IA mantiene la coherencia). */
      assign(type, value) {
        const key = type + '\u0000' + value;
        let ph = this.byValue.get(key);
        if (ph) return ph;
        const n = (this.counters[type] || 0) + 1;
        this.counters[type] = n;
        ph = '[' + type + '_' + n + '_' + this.tag + ']';
        this.byValue.set(key, ph);
        this.byPlaceholder.set(ph, value);
        return ph;
      }
      lookup(ph) {
        return this.byPlaceholder.get(ph);
      }
      get size() {
        return this.byPlaceholder.size;
      }
      clear() {
        this.byValue.clear();
        this.byPlaceholder.clear();
        this.counters = Object.create(null);
      }
    }

    function restore(text, vault) {
      if (text.indexOf('[') === -1) return text;
      return text.replace(new RegExp(PLACEHOLDER_SRC, 'g'), (m) => {
        const v = vault.lookup(m);
        return v === undefined ? m : v; // marcadores desconocidos se dejan intactos
      });
    }

    // Si un hallazgo "envuelve" marcadores ya puestos (p. ej. tras sustituir a un vecino),
    // se guarda su valor ORIGINAL expandido para que restaurar devuelva siempre el texto real.
    function assignExpanded(vault, f) {
      return vault.assign(f.type, restore(f.value, vault));
    }

    // Repite pasadas hasta que no queda nada: sustituir un dato puede dejar al descubierto
    // otro que antes no se reconocía por estar pegado a él (p. ej. "a@x.com4111…").
    function pseudonymize(text, vault) {
      let current = text;
      const all = [];
      for (let pass = 0; pass < 5; pass++) {
        const findings = detect(current);
        if (!findings.length) return { text: current, findings: all };
        let out = '';
        let pos = 0;
        for (const f of findings) {
          out += current.slice(pos, f.start) + assignExpanded(vault, f);
          pos = f.end;
        }
        out += current.slice(pos);
        current = out;
        all.push(...findings);
      }
      // No convergió: fallo seguro (el llamador bloquea el envío).
      throw new Error('No se pudo proteger por completo el texto.');
    }

    function maskValue(value) {
      const v = value.replace(/\s+/g, ' ');
      if (v.length <= 4) return '••••';
      return v.slice(0, 2) + '•'.repeat(Math.min(v.length - 4, 8)) + v.slice(-2);
    }

    return {
      detect, pseudonymize, restore, maskValue, assignExpanded, Vault, setCustomTerms, setDisabled,
      isValidDni, isValidNie, isValidCard, ibanMod97, luhn,
      hasPlaceholder: (t) => PLACEHOLDER_ANY.test(t),
      PLACEHOLDER_SRC, TYPE_LABEL,
    };
  })();
  /* ===== CORE:END ===== */

  /* ===== TOOLS:START ===== (datos puros: prompts de las 8 herramientas) */
  const SUFFIX =
    'Nota: los marcadores entre corchetes como [TIPO_n_ABC] son datos protegidos; cópialos tal cual y no intentes adivinar su contenido.';

  const QUESTIONS = [
    '1) ¿Cómo es tu plan perfecto para un sábado?',
    '2) ¿Qué es lo que más te estresa?',
    '3) ¿Qué te hace más ilusión ahora mismo?',
    '4) ¿Cómo manejas un desacuerdo?',
    '5) ¿Qué es lo que más valoras en una persona cercana?',
  ].join('\n');

  const TOOLS = [
    {
      id: 'indirectas', icon: '🕵️', name: 'Traductor de Indirectas',
      desc: 'Qué quiere decir realmente ese «ya hablamos…».',
      fields: [
