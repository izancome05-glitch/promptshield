    let start = 0;
    for (let i = 0; i < css.length; i++) {
      if (css[i] === '{') depth++;
      else if (css[i] === '}' && --depth === 0) {
        out.push(css.slice(start, i + 1).trim());
        start = i + 1;
      }
    }
    return out.filter(Boolean);
  }

  // Comprueba que los estilos se aplican de verdad (la píldora debe ser position:fixed).
  function stylesWork() {
    try {
      return getComputedStyle(pill).position === 'fixed';
    } catch (_) {
      return false;
    }
  }

  // Algunas páginas (CSP estricta) bloquean ciertas vías de carga de CSS: se prueban en orden y se verifica cada una.
  function installStyles() {
    try {
      const sheet = new CSSStyleSheet();
      sheet.replaceSync(CSS);
      root.adoptedStyleSheets = [sheet];
      if (stylesWork()) return 'hoja construible';
    } catch (_) {
      /* siguiente vía */
    }
    try {
      root.adoptedStyleSheets = [];
    } catch (_) {
      /* ignorado */
    }
    const st = document.createElement('style');
    st.textContent = CSS;
    root.append(st);
    if (stylesWork()) return '<style> con texto';
    st.remove();
    const st2 = document.createElement('style');
    root.append(st2);
    const sh = st2.sheet;
    if (sh) {
      for (const rule of splitRules(CSS)) {
        try {
          sh.insertRule(rule, sh.cssRules.length);
        } catch (_) {
          /* regla inválida: se omite */
        }
      }
    }
    if (stylesWork()) return 'CSSOM (insertRule)';
    console.warn('[PromptShield] No se pudieron aplicar los estilos de la interfaz.');
    return 'ninguna (fallo)';
  }

  function refreshPill() {
    pill.dataset.on = String(settings.enabled);
    pillLabel.textContent = settings.enabled ? 'PromptShield' : 'En pausa';
    pillCount.textContent = String(stats.protected);
    pillCount.hidden = !stats.protected;
    if (swEl) swEl.setAttribute('aria-checked', String(settings.enabled));
    if (statNodes.p) statNodes.p.textContent = String(stats.protected);
    if (statNodes.b) statNodes.b.textContent = String(stats.bypassed);
  }

  function togglePanel() {
    panel.hidden = !panel.hidden;
  }

  /* ---------- Piezas reutilizables ---------- */

  // Distintivo de autoría (visible en el panel y en el selector de herramientas).
  function credit() {
    return h('span', { class: 'credit', title: 'Diseño y desarrollo' },
      h('span', { class: 'seal', 'aria-hidden': 'true' }, 'IH'),
      h('span', {}, 'Creado por ', h('b', {}, AUTHOR)));
  }

  // Control segmentado accesible (sustituye a los <select>).
  function seg(options, value, onpick) {
    const el = h('div', { class: 'seg', role: 'group' });
    const btns = options.map(([val, label]) => {
      const b = h('button', { type: 'button', 'aria-pressed': String(val === value) }, label);
      b.addEventListener('click', () => {
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        onpick(val);
      });
      return b;
    });
    el.append(...btns);
    return el;
  }

  function head(eyebrow, title, onclose, warn) {
    return h('div', { class: 'chead' },
      h('div', {}, h('div', { class: 'eyebrow' + (warn ? ' warn' : '') }, eyebrow), h('h2', {}, title)),
      h('button', { class: 'x', type: 'button', 'aria-label': 'Cerrar', onclick: onclose }, icon('close')));
  }

  function buildPanel() {
    swEl = h('button', {
      class: 'sw', type: 'button', role: 'switch', 'aria-label': 'Protección activa', 'aria-checked': String(settings.enabled),
      onclick: () => {
        settings.enabled = !settings.enabled;
        saveSettings();
        refreshPill();
      },
    });
    const modeSeg = seg([['ask', 'Preguntar'], ['auto', 'Automático']], settings.mode, (v) => {
      settings.mode = v === 'auto' ? 'auto' : 'ask';
      saveSettings();
    });
    const themeSeg = seg([['auto', 'Auto'], ['light', 'Claro'], ['dark', 'Oscuro']], settings.theme, (v) => {
      settings.theme = v === 'light' || v === 'dark' ? v : 'auto';
      saveSettings();
      applyTheme();
    });
    const toolsBtn = h('button', { class: 'btn primary wide', type: 'button', onclick: () => {
      panel.hidden = true;
      showTools();
    } }, icon('grid'), h('span', { class: 'grow' }, 'Abrir herramientas'), h('kbd', {}, '⌥⇧T'));
    const rulesBtn = h('button', { class: 'btn wide', type: 'button', onclick: () => {
      panel.hidden = true;
      showRules();
    } }, icon('sliders'), h('span', { class: 'grow' }, 'Reglas de protección'));
    const clearBtn = h('button', { class: 'linkbtn', type: 'button', onclick: () => {
      vault.clear();
      toast('Datos de la sesión olvidados', 'warn');
    } }, 'Olvidar datos de la sesión');
    statNodes.p = h('b', {}, '0');
    statNodes.b = h('b', {}, '0');

    return h('div', { class: 'panel', role: 'dialog', 'aria-label': 'PromptShield' },
      h('div', { class: 'phead' },
        h('span', { class: 'mark lg' }, icon('shield')),
        h('div', { class: 'ptitle' }, h('strong', {}, 'PromptShield'), h('span', {}, 'Cortafuegos de privacidad'))),
      h('div', { class: 'pbody' },
        h('div', { class: 'line' },
          h('div', {}, h('div', { class: 'lbl' }, 'Protección'), h('p', { class: 'hint' }, 'Sustituye datos sensibles antes de enviar')),
          swEl),
        h('div', { class: 'line stack' }, h('div', { class: 'lbl' }, 'Modo'), modeSeg),
        h('div', { class: 'line stack' }, h('div', { class: 'lbl' }, 'Tema'), themeSeg),
        h('div', { class: 'line stack' }, toolsBtn, rulesBtn),
        h('div', { class: 'stats' },
          h('div', {}, statNodes.p, h('span', {}, 'Datos protegidos')),
          h('div', {}, statNodes.b, h('span', {}, 'Enviados sin proteger'))),
        clearBtn),
      h('div', { class: 'pfoot' }, credit(), h('span', { class: 'ver' }, 'v' + VERSION)));
  }

  function toast(msg, kind) {
    if (!toasts) return;
    const t = h('div', { class: 'toast ' + (kind || '') }, msg);
    toasts.append(t);
    setTimeout(() => t.remove(), 4000);
  }

  /* ---------- Diálogos ---------- */

  function closeModal(editor) {
    if (overlay) overlay.remove();
    overlay = null;
    modalOpen = false;
    if (editor && document.contains(editor)) editor.focus();
  }

  // Escape cierra; Tab queda atrapado dentro; el teclado no llega a la página.
  function overlayKeys(editor) {
    return (e) => {
      e.stopPropagation();
      if (e.key === 'Escape') {
        closeModal(editor);
        return;
      }
      if (e.key !== 'Tab' || !overlay) return;
      const f = Array.from(overlay.querySelectorAll('button, textarea, select, input')).filter((el) => !el.disabled && !el.hidden);
      if (!f.length) return;
      const cur = root.activeElement;
      if (e.shiftKey && cur === f[0]) {
        e.preventDefault();
        f[f.length - 1].focus();
      } else if (!e.shiftKey && cur === f[f.length - 1]) {
        e.preventDefault();
        f[0].focus();
      }
    };
  }

  function openOverlay(card, focusEl, editor) {
    if (overlay) overlay.remove();
    modalOpen = true;
    overlay = h('div', { class: 'overlay', onkeydown: overlayKeys(editor) }, card);
    ['keyup', 'keypress', 'input'].forEach((t) => overlay.addEventListener(t, (ev) => ev.stopPropagation()));
    wrap.append(overlay);
    if (focusEl) focusEl.focus();
  }

  function showModal({ kind, findings, editor, error }) {
    const cancel = h('button', { class: 'btn ghost', type: 'button', onclick: () => closeModal(editor) }, 'Cancelar');
    const unprotected = h('button', { class: 'btn danger', type: 'button', onclick: () => {
      closeModal(editor);
      runSendUnprotected(editor);
    } }, 'Enviar sin proteger');

    if (kind === 'findings') {
      const items = findings.slice(0, 8).map((f) =>
        h('li', {}, h('span', { class: 'chip' }, Core.TYPE_LABEL[f.type] || f.type), h('code', {}, Core.maskValue(f.value))));
      if (findings.length > 8) items.push(h('li', {}, h('span', { class: 'hint' }, 'y ' + (findings.length - 8) + ' más…')));
      const protect = h('button', { class: 'btn primary', type: 'button', onclick: () => {
        closeModal(editor);
        runProtectAndSend(editor);
      } }, icon('lock'), 'Proteger y enviar');
      const previewBox = h('pre', { class: 'preview' });
      previewBox.hidden = true;
      const previewBtn = h('button', { class: 'btn ghost', type: 'button', onclick: () => {
        if (!previewBox.hidden) {
          previewBox.hidden = true;
          return;
        }
        try {
          const { text } = Core.pseudonymize(readEditorText(editor), vault);
          previewBox.textContent = text.length > 3000 ? text.slice(0, 3000) + '\n…' : text;
        } catch (err) {
          previewBox.textContent = 'No se pudo generar la vista previa: ' + ((err && err.message) || 'error');
        }
        previewBox.hidden = false;
      } }, icon('eye'), 'Vista previa');
      const card = h('div', { class: 'card', role: 'dialog', 'aria-modal': 'true' },
        head('Antes de enviar', 'Hemos encontrado datos sensibles', () => closeModal(editor)),
        h('p', { class: 'lead' }, 'Se han detectado ' + findings.length + ' dato(s) en tu mensaje. Nada ha salido todavía de tu navegador.'),
        h('ul', { class: 'list' }, items),
        h('p', { class: 'hint' }, '«Proteger» los sustituye por marcadores y los restaura solo en tu pantalla cuando la IA responda.'),
        previewBox,
        h('div', { class: 'actions' }, previewBtn, h('span', { class: 'grow' }), cancel, unprotected, protect));
      openOverlay(card, protect, editor);
    } else {
      const card = h('div', { class: 'card', role: 'alertdialog', 'aria-modal': 'true' },
        head('Seguridad', 'Envío bloqueado', () => closeModal(editor), true),
        h('p', { class: 'lead' }, 'PromptShield no ha podido comprobar el mensaje con garantías: ' + ((error && error.message) || 'error desconocido')),
        h('p', { class: 'hint' }, 'Por defecto no se envía nada. Revisa el texto o decide enviarlo bajo tu responsabilidad.'),
        h('div', { class: 'actions' }, h('span', { class: 'grow' }), unprotected, cancel));
      openOverlay(card, cancel, editor);
    }
  }

  // Selector de herramientas con búsqueda y filtro por categoría.
  function showTools() {
    let draft = '';
    try {
      const ed = findPromptEditor();
      draft = ed ? readEditorText(ed).trim() : '';
    } catch (_) {
      draft = '';
    }
    let q = '';
    let cat = 'Todas';
    const cats = ['Todas'].concat(Array.from(new Set(TOOLS.map(catOf))));

    const cards = TOOLS.map((t, i) => {
      const b = h('button', { class: 'tcard', type: 'button', onclick: () => showTool(t, 0, draft) },
        h('span', { class: 'tnum' }, String(i + 1).padStart(2, '0')),
        h('strong', {}, t.name),
        h('span', { class: 'tdesc' }, t.desc),
        h('span', { class: 'tcat' }, catOf(t)));
      b.style.animationDelay = Math.min(i * 18, 220) + 'ms';
      return b;
    });
    const empty = h('div', { class: 'empty' }, 'Ninguna herramienta coincide con tu búsqueda.');
    empty.hidden = true;
    const apply = () => {
      let n = 0;
      cards.forEach((b, i) => {
        const t = TOOLS[i];
        const ok = (cat === 'Todas' || catOf(t) === cat) && (!q || (t.name + ' ' + t.desc).toLowerCase().includes(q));
        b.hidden = !ok;
        if (ok) n++;
      });
      empty.hidden = n > 0;
    };
    const search = h('input', { class: 'search', type: 'search', placeholder: 'Buscar herramienta…', 'aria-label': 'Buscar herramienta', oninput: (e) => {
      q = e.target.value.trim().toLowerCase();
      apply();
    } });
    const chips = cats.map((c) => {
      const b = h('button', { class: 'chipbtn', type: 'button', 'aria-pressed': String(c === cat) }, c);
      b.addEventListener('click', () => {
        cat = c;
        chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        apply();
      });
      return b;
    });

    const card = h('div', { class: 'card wide', role: 'dialog', 'aria-modal': 'true' },
      head('Herramientas', '¿Qué necesitas hoy?', () => closeModal()),
      h('p', { class: 'lead' }, 'Rellenas unos datos, se escribe el prompt en el chat y se envía tras la comprobación de datos sensibles.'),
      h('div', { class: 'field' }, icon('search'), search),
      h('div', { class: 'chips' }, chips),
      h('div', { class: 'grid' }, cards, empty),
      h('div', { class: 'cfoot' }, credit(), h('span', { class: 'hint' }, TOOLS.length + ' herramientas')));
    openOverlay(card, search);
  }

  function showTool(tool, modeIdx, prefill) {
    const spec = tool.modes ? tool.modes[modeIdx] : tool;
    const areas = spec.fields.map((f, i) => {
      const ta = h('textarea', { class: 'in', rows: f.rows || 4, placeholder: f.ph || '' });
      if (i === 0 && prefill) ta.value = prefill;
      return ta;
    });
    const fields = spec.fields.map((f, i) =>
      h('label', { class: 'fld' }, h('span', { class: 'flabel' }, f.label, f.req ? h('i', {}, ' *') : null), areas[i]));
    const modeSeg = tool.modes
      ? seg(tool.modes.map((m, i) => [String(i), m.label]), String(modeIdx), (v) =>
          showTool(tool, Number(v), areas[0] ? areas[0].value : ''))
      : null;

    const back = h('button', { class: 'btn ghost', type: 'button', onclick: () => showTools() }, icon('back'), 'Volver');
    const go = h('button', { class: 'btn primary', type: 'button', onclick: () => {
      const values = areas.map((a) => a.value);
      const missing = spec.fields.findIndex((f, i) => f.req && !values[i].trim());
      if (missing >= 0) {
        toast('Falta: ' + spec.fields[missing].label, 'warn');
        areas[missing].focus();
        return;
      }
      const text = buildToolPrompt(spec, values);
      closeModal();
      runTool(text);
    } }, icon('send'), 'Generar y enviar', h('kbd', {}, 'Ctrl ↵'));
    areas.forEach((a) => a.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        go.click();
      }
    }));

    const card = h('div', { class: 'card wide', role: 'dialog', 'aria-modal': 'true' },
      head(catOf(tool), tool.name, () => closeModal()),
      h('p', { class: 'lead' }, tool.desc),
      modeSeg,
      tool.intro ? h('div', { class: 'intro' }, tool.intro) : null,
      fields,
      h('div', { class: 'actions' }, back, h('span', { class: 'grow hint' }, 'Se comprueban datos sensibles antes de enviar. Nada se guarda.'), go));
    openOverlay(card, areas[0]);
  }

  function showRules() {
    const types = Object.keys(Core.TYPE_LABEL).filter((t) => t !== 'SECRETO');
    const checks = types.map((t) => {
      const c = h('input', { type: 'checkbox' });
      c.checked = !settings.off.includes(t);
      return { t, c };
    });
    const words = h('textarea', { class: 'in', rows: 5, placeholder: 'Un nombre, empresa o proyecto por línea' });
    words.value = customTerms.join('\n');
    const cancel = h('button', { class: 'btn ghost', type: 'button', onclick: () => closeModal() }, 'Cancelar');
    const save = h('button', { class: 'btn primary', type: 'button', onclick: () => {
      settings.off = checks.filter((x) => !x.c.checked).map((x) => x.t);
      saveSettings();
      Core.setDisabled(settings.off);
      customTerms = words.value.split('\n').map((x) => x.trim()).filter(Boolean).slice(0, 200);
      Core.setCustomTerms(customTerms);
      closeModal();
      toast('Reglas guardadas', 'ok');
    } }, 'Guardar');
    const card = h('div', { class: 'card', role: 'dialog', 'aria-modal': 'true' },
      head('Ajustes', 'Reglas de protección', () => closeModal()),
      h('p', { class: 'lead' }, 'Elige qué tipos de dato se detectan. Las claves y los secretos siempre se protegen.'),
      h('div', { class: 'rules' }, checks.map((x) => h('label', { class: 'opt' }, x.c, Core.TYPE_LABEL[x.t]))),
      h('label', { class: 'fld' }, h('span', { class: 'flabel' }, 'Palabras propias a proteger'), words),
      h('p', { class: 'hint' }, 'Se buscan sin distinguir mayúsculas y solo se guardan en memoria: se pierden al recargar la página.'),
      h('div', { class: 'actions' }, h('span', { class: 'grow' }), cancel, save));
    openOverlay(card, words);
  }

  /* ---------- Arranque ---------- */

  function init() {
    mountUI();
    window.addEventListener('keydown', onKeydown, true);
    window.addEventListener('click', onClick, true);
    window.addEventListener('submit', onSubmit, true);
    startRestoreObserver();
    // Si la SPA elimina nuestro nodo, se vuelve a montar.
    setInterval(() => {
      if (!host.isConnected) document.documentElement.append(host);
    }, 3000);
  }

  try {
    init();
  } catch (err) {
    console.error('[PromptShield] No se pudo iniciar:', err);
  }
})();
