  /* ---------- Utilidades DOM ---------- */

  function visible(el) {
    return !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);
  }

  // Constructor de nodos SIN innerHTML (compatible con Trusted Types y sin XSS).
  function h(tag, attrs, ...children) {
    const el = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs || {})) {
      if (k === 'class') el.className = v;
      else if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
      else if (v !== false && v != null) el.setAttribute(k, String(v));
    }
    for (const c of children.flat()) {
      if (c == null) continue;
      el.append(typeof c === 'object' ? c : document.createTextNode(String(c)));
    }
    return el;
  }

  /* ---------- Lectura/escritura del editor ---------- */

  // Texto "virtual" de un contenteditable: concatena los nodos de texto e inserta
  // "\n" entre bloques/<br>, guardando a qué nodo pertenece cada tramo.
  function buildVirtual(root) {
    const segs = [];
    let text = '';
    let prevBlock = null;
    const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT | NodeFilter.SHOW_ELEMENT);
    for (let n = w.nextNode(); n; n = w.nextNode()) {
      if (n.nodeType === Node.ELEMENT_NODE) {
        if (n.nodeName === 'BR') text += '\n';
        continue;
      }
      const block = blockOf(n, root);
      if (prevBlock && block !== prevBlock) text += '\n';
      prevBlock = block;
      segs.push({ node: n, start: text.length });
      text += n.data;
    }
    return { text, segs };
  }

  function blockOf(node, root) {
    let el = node.parentElement;
    while (el && el !== root) {
      if (!getComputedStyle(el).display.startsWith('inline')) return el;
      el = el.parentElement;
    }
    return root;
  }

  function locate(v, off, isEnd) {
    for (const s of v.segs) {
      const len = s.node.data.length;
      const hit = isEnd ? off > s.start && off <= s.start + len : off >= s.start && off < s.start + len;
      if (hit) return { node: s.node, offset: off - s.start };
    }
    return null;
  }

  function readEditorText(editor) {
    return editor instanceof HTMLTextAreaElement ? editor.value : buildVirtual(editor).text;
  }

  function setTextareaValue(el, text) {
    // Setter nativo: React ignora asignaciones directas a .value.
    const setter = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, 'value').set;
    setter.call(el, text);
    el.dispatchEvent(new Event('input', { bubbles: true }));
  }

  // Sustituye un rango del contenteditable simulando que el usuario escribe
  // (así ProseMirror/Quill/Lexical actualizan su estado interno).
  function replaceRange(editor, v, start, end, placeholder) {
    const a = locate(v, start, false);
    const b = locate(v, end, true);
    if (!a || !b) return false;
    const range = document.createRange();
    range.setStart(a.node, a.offset);
    range.setEnd(b.node, b.offset);
    editor.focus();
    const sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
    if (document.execCommand('insertText', false, placeholder)) return true;
    try {
      const dt = new DataTransfer();
      dt.setData('text/plain', placeholder);
      editor.dispatchEvent(new ClipboardEvent('paste', { clipboardData: dt, bubbles: true, cancelable: true }));
      return true;
    } catch (_) {
      return false;
    }
  }

  // Sustituye TODO el contenido del editor por `text` (admite varias líneas).
  // Devuelve true solo si el editor acaba mostrando exactamente ese texto.
  async function setEditorText(editor, text) {
    if (editor instanceof HTMLTextAreaElement) {
      setTextareaValue(editor, text);
      await sleep(40);
      return squash(editor.value) === squash(text);
    }
    const selectAll = () => {
      editor.focus();
      const r = document.createRange();
      r.selectNodeContents(editor);
      const s = window.getSelection();
      s.removeAllRanges();
      s.addRange(r);
    };
    const same = () => squash(readEditorText(editor)) === squash(text);

    // Plan A: pegado simulado (ProseMirror/Quill lo gestionan con párrafos correctos).
    selectAll();
    try {
      const dt = new DataTransfer();
      dt.setData('text/plain', text);
      editor.dispatchEvent(new ClipboardEvent('paste', { clipboardData: dt, bubbles: true, cancelable: true }));
    } catch (_) {
      /* se pasa al plan B */
    }
    await sleep(150);
    if (same()) return true;

    // Plan B: línea a línea con párrafos.
    selectAll();
    document.execCommand('delete');
    const lines = text.split('\n');
    for (let i = 0; i < lines.length; i++) {
      if (i) document.execCommand('insertParagraph');
      if (lines[i]) document.execCommand('insertText', false, lines[i]);
    }
    await sleep(150);
    return same();
  }

  /**
   * Protege el contenido del editor. Devuelve { ok, count }.
   * ok=true SOLO si, tras sustituir, una nueva detección no encuentra nada.
   */
  async function protectEditor(editor) {
    if (editor instanceof HTMLTextAreaElement) {
      const { text, findings } = Core.pseudonymize(editor.value, vault);
      setTextareaValue(editor, text);
      await sleep(40);
      return { ok: Core.detect(readEditorText(editor)).length === 0, count: findings.length };
    }

    // 1) Se registran los marcadores en orden de aparición (numeración natural).
    const first = Core.detect(buildVirtual(editor).text);
    first.forEach((f) => Core.assignExpanded(vault, f));

    // 2) Se sustituye de derecha a izquierda recalculando tras cada edición
    //    (el DOM del editor puede reconstruirse entre ediciones).
    const maxIter = first.length + 5;
    for (let i = 0; i < maxIter; i++) {
      const v = buildVirtual(editor);
      const found = Core.detect(v.text);
      if (!found.length) break;
      const last = found[found.length - 1];
      if (!replaceRange(editor, v, last.start, last.end, Core.assignExpanded(vault, last))) break;
      await sleep(15);
    }
    await sleep(40);
    return { ok: Core.detect(buildVirtual(editor).text).length === 0, count: first.length };
  }

  /* ---------- Adaptadores por sitio (la parte más frágil: selectores aislados) ---------- */

  const EDITOR_SELECTORS = [
    '#prompt-textarea', // ChatGPT
    'div.ProseMirror[contenteditable]:not([contenteditable="false"])', // Claude / ChatGPT
    'rich-textarea .ql-editor', // Gemini
    'div.ql-editor[contenteditable]:not([contenteditable="false"])',
    'textarea',
  ];
  const SEND_SELECTORS = [
    'button[data-testid="send-button"]', // ChatGPT
    'button[aria-label*="Send" i]', // Claude y otros (EN)
    'button[aria-label*="Enviar" i]', // Gemini y otros (ES)
    'button.send-button',
    'button[type="submit"]',
  ];
  const EDITABLE_CLOSEST =
    'textarea, [contenteditable]:not([contenteditable="false"]), [role="textbox"]';

  function resolveEditor(target) {
    if (!(target instanceof Element)) return null;
    const el = target.closest(EDITABLE_CLOSEST);
    return el && visible(el) ? el : null;
  }

  function findPromptEditor() {
    for (const sel of EDITOR_SELECTORS) {
      const els = Array.from(document.querySelectorAll(sel)).filter(visible);
      if (els.length) return els[els.length - 1];
    }
    return null;
  }

  function isSendButton(btn) {
    return SEND_SELECTORS.some((sel) => btn.matches(sel));
  }

  function findSendButton(editor) {
    let scope = editor;
    for (let i = 0; i < 8 && scope; i++, scope = scope.parentElement) {
      for (const sel of SEND_SELECTORS) {
        const b = Array.from(scope.querySelectorAll(sel)).find(visible);
        if (b) return b;
      }
    }
    return null;
  }

  const isEnabled = (b) => !b.disabled && b.getAttribute('aria-disabled') !== 'true';

  async function waitFor(fn, timeout) {
    const t0 = Date.now();
    for (;;) {
      const r = fn();
      if (r) return r;
      if (Date.now() - t0 > timeout) return null;
      await sleep(50);
    }
  }

  function withBypass(fn) {
    bypass++;
    try {
      fn();
    } finally {
      bypass--;
    }
  }

  async function sendNow(editor) {
    await sleep(80);
    const btn = await waitFor(() => {
      const b = findSendButton(editor);
      return b && isEnabled(b) ? b : null;
    }, 1500);
    withBypass(() => {
      if (btn) btn.click();
      else
        editor.dispatchEvent(
          new KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true, cancelable: true })
        );
    });
    await sleep(900);
    if (document.contains(editor) && readEditorText(editor).trim()) {
      toast('Texto listo. Pulsa Enviar manualmente.', 'warn');
    }
  }

  /* ---------- Interceptación del envío ---------- */

  function block(e) {
    e.preventDefault();
    e.stopImmediatePropagation();
  }

  function handleSubmitAttempt(e, editor) {
    if (modalOpen || busy) {
      block(e);
      return;
    }
    let findings;
    try {
      findings = Core.detect(readEditorText(editor));
    } catch (err) {
      block(e); // FALLO SEGURO: ante cualquier error, no se envía nada
      showModal({ kind: 'error', error: err, editor });
      return;
    }
    if (!findings.length) return; // nada sensible: el envío sigue su curso
    block(e);
    if (settings.mode === 'auto') runProtectAndSend(editor);
    else showModal({ kind: 'findings', findings, editor });
  }

  function onKeydown(e) {
    // Atajos: Alt+Mayús+S pausa/activa la protección; Alt+Mayús+T abre las herramientas.
    if (e.altKey && e.shiftKey && !e.ctrlKey && !e.metaKey && !modalOpen) {
      if (e.code === 'KeyS') {
        e.preventDefault();
        settings.enabled = !settings.enabled;
        saveSettings();
        refreshPill();
        toast(settings.enabled ? 'Protección activada' : 'Protección en pausa', settings.enabled ? 'ok' : 'warn');
        return;
      }
      if (e.code === 'KeyT') {
        e.preventDefault();
        showTools();
        return;
      }
    }
    if (!settings.enabled || bypass > 0) return;
    if (e.key !== 'Enter' || e.shiftKey || e.altKey || e.isComposing) return;
    const editor = resolveEditor(e.target);
    if (editor) handleSubmitAttempt(e, editor);
  }

  function onClick(e) {
    // Un clic fuera de PromptShield cierra el panel (dentro, el target es el host).
    if (panel && !panel.hidden && e.target !== host) panel.hidden = true;
    if (!settings.enabled || bypass > 0) return;
    if (!(e.target instanceof Element)) return;
    const btn = e.target.closest('button, [role="button"]');
    if (!btn || !isSendButton(btn)) return;
    const editor = findPromptEditor();
    if (editor) handleSubmitAttempt(e, editor);
  }

  function onSubmit(e) {
    if (!settings.enabled || bypass > 0) return;
    const form = e.target;
    if (!(form instanceof HTMLFormElement)) return;
    const editor = Array.from(form.querySelectorAll(EDITABLE_CLOSEST)).find(visible);
    if (editor) handleSubmitAttempt(e, editor);
  }

  async function runProtectAndSend(editor) {
    if (busy) return;
    busy = true;
    try {
      const { ok, count } = await protectEditor(editor);
      if (!ok) {
        showModal({
          kind: 'error',
          error: new Error('No se pudo sustituir el texto de forma verificable en este editor.'),
          editor,
        });
        return;
      }
      stats.protected += count;
      refreshPill();
      toast(count + ' dato(s) protegido(s)', 'ok');
      await sendNow(editor);
    } catch (err) {
      showModal({ kind: 'error', error: err, editor });
    } finally {
      busy = false;
    }
  }

  async function runSendUnprotected(editor) {
    if (busy) return;
    busy = true;
    try {
      stats.bypassed++;
      await sendNow(editor);
    } finally {
      busy = false;
    }
  }

  // Envío de un texto sin datos sensibles (o con la protección pausada).
  async function runSendPlain(editor) {
    if (busy) return;
    busy = true;
    try {
      await sendNow(editor);
    } catch (err) {
      showModal({ kind: 'error', error: err, editor });
    } finally {
      busy = false;
    }
  }

  // Misma política que un envío manual: detectar -> (preguntar | proteger) -> enviar.
  async function submitPrompt(editor) {
    let findings = [];
    if (settings.enabled) {
      try {
        findings = Core.detect(readEditorText(editor));
      } catch (err) {
        showModal({ kind: 'error', error: err, editor }); // FALLO SEGURO
        return;
      }
    }
    if (!findings.length) await runSendPlain(editor);
    else if (settings.mode === 'auto') await runProtectAndSend(editor);
    else showModal({ kind: 'findings', findings, editor });
  }

  /* ---------- Herramientas: ejecución ---------- */

