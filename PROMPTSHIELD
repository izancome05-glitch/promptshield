  const squash = (s) => s.replace(/\s+/g, '');

  function loadSettings() {
    const d = { enabled: true, mode: 'ask', theme: 'auto', off: [] };
    try {
      const raw = localStorage.getItem(SETTINGS_KEY);
      if (!raw) return d;
      const o = JSON.parse(raw);
      return {
        enabled: typeof o.enabled === 'boolean' ? o.enabled : d.enabled,
        mode: o.mode === 'auto' ? 'auto' : 'ask',
        theme: o.theme === 'light' || o.theme === 'dark' ? o.theme : 'auto',
        off: Array.isArray(o.off) ? o.off.filter((t) => typeof t === 'string' && t !== 'SECRETO') : [],
      };
    } catch (_) {
      return d;
    }
  }
  function saveSettings() {
    try {
      localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings)); // solo ajustes, nunca datos
    } catch (_) {
      /* almacenamiento no disponible: se ignora */
    }
